# Copia este archivo como ".env" (en la raiz del proyecto) y reemplaza los valores.
# ".env" esta excluido de Git: nunca lo subas. Este archivo de ejemplo solo trae valores de relleno.

# --- Obligatorias: conexion a MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=motorguardian
DB_USER=motorguardian_app
DB_PASSWORD=cambia_esta_clave

# --- Obligatoria: clave para firmar los tokens de sesion (cadena larga y aleatoria) ---
SECRET_KEY=cambia_esto_por_una_cadena_larga_y_aleatoria

# --- Opcionales: avisos por correo (si se dejan vacias, el canal se omite) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_REMITENTE=

# --- Opcional: avisos por Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Opcional: resumen redactado por IA en los reportes ---
OPENAI_API_KEY=
