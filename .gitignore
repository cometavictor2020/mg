# Entornos virtuales
venv/
.venv/

# Python
__pycache__/
*.pyc

# Variables de entorno (credenciales de base de datos, etc.)
.env
.env.*
# Excepcion: el archivo de ejemplo (solo valores de relleno, sin credenciales) si se sube
!.env.example

# Editor
.vscode/
.claude/

# Archivos temporales de Office (bloqueo al abrir un documento)
~$*

# Datos de vibracion (reales y sinteticos): pueden pesar decenas de MB
# por captura (10 kHz x 3 ejes x hasta 60s = ~31 MB) y superan el limite
# de GitHub - mismo criterio que respaldos/ y reportes/, carpeta
# completa en vez de un nombre de archivo puntual.
datos/

# Respaldos de la base de datos (D-022: nunca via Git/GitHub)
respaldos/

# PDFs de reportes generados (datos, no codigo - mismo criterio que respaldos/)
reportes/

# Datos sinteticos de desalineacion y su generador: uso local del desarrollador, no se sube (decision del usuario)
herramientas/local_sin_git/
